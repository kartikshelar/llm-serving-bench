#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/llm-serving-bench-boot.log) 2>&1
echo "boot $(date -Is)"

systemctl enable --now docker || true
nvidia-ctk runtime configure --runtime=docker 2>/dev/null || true
systemctl restart docker || true
nvidia-smi -L || true

REGION="${aws_region}"
ECR_REGISTRY="${ecr_registry}"
ECR_REPO="${ecr_repository}"
IMAGE_PARAM="${image_param}"

# Prefer CI-published URI; fall back to :latest on this repo.
IMAGE="$(aws ssm get-parameter --name "$IMAGE_PARAM" --region "$REGION" --query Parameter.Value --output text 2>/dev/null || true)"
if [[ -z "$IMAGE" || "$IMAGE" == "placeholder:not-pushed-yet" ]]; then
  IMAGE="$${ECR_REPO}:latest"
fi

echo "deploy_image=$IMAGE"
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"

docker rm -f llm-serve 2>/dev/null || true
if docker pull "$IMAGE"; then
  docker run -d --name llm-serve --gpus all --restart unless-stopped \
    -p 8000:8000 \
    -e HF_HOME=/root/.cache/huggingface \
    -v /home/ubuntu/.cache/huggingface:/root/.cache/huggingface \
    "$IMAGE"
  echo "container_started $(date -Is)"
else
  echo "ecr_pull_failed — node booted without serving container" >&2
fi

echo "boot_ready $(date -Is)"
